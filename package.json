{
	"name": "@l3dev/discord-bot-tickets-plugin",
	"version": "0.7.0",
	"description": "A plugin for discord bot tickets",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"import": "./build/index.js",
			"require": "./build/index.js"
		},
		"./db-schema": {
			"types": "./build/db-schema/index.d.ts",
			"import": "./build/db-schema/index.js",
			"require": "./build/db-schema/index.js"
		}
	},
	"files": [
		"build"
	],
	"scripts": {
		"build": "rm -rf build && tsc -p tsconfig.json",
		"package": "pnpm build",
		"prepublishOnly": "pnpm package",
		"lint": "prettier --check . && eslint .",
		"lint-fix": "prettier --check --write . && eslint . --fix",
		"format": "prettier --write ."
	},
	"author": "l3dotdev",
	"license": "MIT",
	"peerDependencies": {
		"@l3dev/discord.js-helpers": ">=0.10.1 <1.0.0",
		"discord.js": ">=14.23.2 <15.0.0",
		"drizzle-orm": "^0.44.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@l3dev/drizzle-helpers": "^0.2.6",
		"@types/node": "^22.14.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"globals": "^16.0.0",
		"prettier": "^3.9.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	},
	"dependencies": {
		"@l3dev/logger": "^0.3.1",
		"@l3dev/result": "^0.4.0"
	}
}